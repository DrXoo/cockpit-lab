    "format": "prettier --write .",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}

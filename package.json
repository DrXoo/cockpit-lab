{
  "name": "cockpit-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Web configurator for compact sim racing and VR flight cockpits.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",

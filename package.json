{
  "name": "cockpit-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Web configurator for compact sim racing and VR flight cockpits.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "look": "node scripts/look.mjs",
    "rename": "node scripts/rename.ts",
    "test": "node --test",
    "check": "node scripts/check.mjs && node scripts/check-casts.ts && npm run typecheck && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p .",
    "prepare": "git config core.hooksPath scripts/hooks",
    "test:e2e": "playwright test",
    "test:e2e:stress": "node scripts/e2e-stress.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}

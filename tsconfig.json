{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Type checking only: Vite builds the app and Node strips the types when running tests.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "strict": true,
    "allowJs": false
  },
  "include": ["src", "scripts", "tests", "e2e", "playwright.config.ts"],
  // Test files not type-checked yet, while the tests move to TypeScript.
  "exclude": [
    "tests/cad-adjustments.test.ts",
    "tests/cad-assembly.test.ts",
    "tests/cad-drafts.test.ts",
    "tests/cad-driver.test.ts",
    "tests/cad-handles.test.ts",
    "tests/cad-measure.test.ts",
    "tests/cad-parts-to-buy.test.ts",
    "tests/cad-peripherals.test.ts",
    "tests/cad-picking.test.ts",
    "tests/cad-replay.test.ts",
    "tests/cad-snapping.test.ts",
    "tests/cockpit-design.test.ts",
    "tests/cockpit-editor-view.test.ts",
    "tests/layout-picking.test.ts",
    "tests/model.test.ts",
    "tests/project-storage.test.ts",
    "tests/project.test.ts",
    "tests/render-annotations.test.ts",
    "tests/render-cad-dimensions.test.ts",
    "tests/render-cad.test.ts",
    "tests/render-desk.test.ts",
    "tests/render-room.test.ts",
    "tests/room.test.ts",
    "tests/wardrobe-access.test.ts"
  ]
}

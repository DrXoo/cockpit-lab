{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Type checking only: Vite builds the app and Node strips the types when running tests.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Loose while the code moves from JavaScript; modules become strict one by one.
    "strict": false,
    "noImplicitAny": false,
    "allowJs": false
  },
  "include": ["src"]
}
